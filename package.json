{
  "name": "1132-fixer",
  "version": "5.6.0",
  "description": "Zoom 1132 Error Fixer — creates a new Windows user and launches Zoom as that user",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/1132-Fixer/windows.git"
  },
  "bugs": {
    "url": "https://github.com/1132-Fixer/windows/issues"
  },
  "homepage": "https://github.com/1132-Fixer/windows#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "inject-config": "node scripts/inject-config.js",
    "test": "node tools/sanitizer-smoke.js && node tools/shortcut-legacy-smoke.js && node tools/messages-smoke.js && node tools/zoom-detection-smoke.js && node tools/run-verdict-smoke.js && node tools/ps-encoding-smoke.js && node tools/helper-credential-smoke.js && node tools/profile-safety-smoke.js && node tools/electron-security-smoke.js",
    "postinstall": "node scripts/postinstall.js",
    "build": "node scripts/inject-config.js && electron-builder --win portable --x64 --publish never",
    "build:installer": "node scripts/inject-config.js && electron-builder --win nsis --x64 --publish never",
    "build:all": "node scripts/inject-config.js && electron-builder --win --x64 --publish never",
    "release": "node scripts/inject-config.js && electron-builder --win nsis --x64 --publish never"
  },
  "author": "1132 Fixer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.hightexas.1132fixer",
    "publish": {
      "provider": "github",
      "owner": "1132-Fixer",
      "repo": "windows"
    },
    "productName": "1132 Fixer",
    "copyright": "Copyright (c) 2024-2026 1132 Fixer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "publisherName": "High Texas",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "1132 Fixer",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "1132-Fixer-Setup-${version}.${ext}",
      "uninstallDisplayName": "1132 Fixer",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "1132-Fixer-Portable-${version}.${ext}",
      "requestExecutionLevel": "admin"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!node_modules/.cache/**",
      "!feedback-proxy/**",
      "!scripts/**",
      "!legacy/**",
      "!tools/**",
      "!docs/**",
      "!.claude/**",
      "!.cursor/**",
      "!.clinerules/**",
      "!.opencode/**",
      "!.windsurf/**",
      "!.gitmodules",
      "!design-system/**",
      "!assets/social-preview.png",
      "!assets/1132-fixer-logo-transparent.png",
      "!**/*.ps1",
      "!**/*.bat",
      "!**/*.md",
      "!**/*.log",
      "!.ps-*",
      "!.qa-*",
      "!MEMORY.md",
      "!social-preview.png",
      "!test-*/**",
      "!*.zip",
      "!v2/**",
      "!CleanZoom*/**"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/1132-helper-shortcut.ico",
        "to": "1132-helper-shortcut.ico"
      },
      {
        "from": "scripts/zoom-firstrun-setup.ps1",
        "to": "zoom-firstrun-setup.ps1"
      },
      {
        "from": "scripts/grant-media-consent.ps1",
        "to": "grant-media-consent.ps1"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
