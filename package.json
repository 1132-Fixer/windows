{
  "name": "1132-fixer",
  "version": "5.3.8",
  "description": "Zoom 1132 Error Fixer — creates a new Windows user and launches Zoom as that user",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:all": "electron-builder --win --x64",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "author": "High Texas",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.hightexas.1132fixer",
    "publish": {
      "provider": "github",
      "owner": "PrimeUpYourLife",
      "repo": "1132-Fixer-Windows-Releases",
      "private": false,
      "releaseType": "release"
    },
    "productName": "1132 Fixer",
    "copyright": "Copyright (c) 2024-2026 High Texas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "publisherName": "High Texas",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "1132 Fixer",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "artifactName": "1132-Fixer-Setup-${version}.${ext}",
      "uninstallDisplayName": "1132 Fixer",
      "deleteAppDataOnUninstall": false,
      "menuCategory": "1132 Fixer"
    },
    "portable": {
      "artifactName": "1132-Fixer-Portable-${version}.${ext}",
      "requestExecutionLevel": "admin"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!node_modules/.cache/**",
      "!scripts/**",
      "!legacy/**",
      "!tools/**",
      "!docs/**",
      "!.claude/**",
      "!**/*.ps1",
      "!**/*.bat",
      "!**/*.md",
      "!**/*.log",
      "!.ps-*",
      "!.qa-*",
      "!MEMORY.md",
      "!social-preview.png",
      "!test-*/**",
      "!*.zip",
      "!v2/**",
      "!CleanZoom*/**"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "scripts/zoom-firstrun-setup.ps1",
        "to": "zoom-firstrun-setup.ps1"
      },
      {
        "from": "scripts/grant-media-consent.ps1",
        "to": "grant-media-consent.ps1"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
