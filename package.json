{
  "name": "1132-remover",
  "version": "3.0.0",
  "description": "Zoom Data Cleaner & Device Fingerprint Reset Tool",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:old": "electron main.js",
    "dev": "electron . --dev --enable-logging",
    "build": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:all": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "author": "High Texas",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.jg2547.1132remover",
    "productName": "1132 Remover",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "1132 Remover",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": null,
      "license": null,
      "artifactName": "${productName} Setup.exe"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!*.ps1",
      "!*.bat",
      "!*.md",
      "!assets/**"
    ],
    "extraResources": []
  }
}
