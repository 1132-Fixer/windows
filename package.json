{
  "name": "cleanstate-sentinel",
  "version": "2.0.0",
  "description": "Forensic-grade software remediation platform with attestation reporting",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:old": "electron main.js",
    "dev": "electron . --dev --enable-logging",
    "build": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:all": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "High Texas",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cleanstate.sentinel",
    "productName": "CleanState Sentinel",
    "copyright": "Copyright (c) 2024-2026 High Texas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "publisherName": "High Texas"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CleanState Sentinel",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "artifactName": "${productName} Setup ${version}.exe",
      "uninstallDisplayName": "CleanState Sentinel",
      "deleteAppDataOnUninstall": false,
      "menuCategory": "CleanState Sentinel"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.exe",
      "requestExecutionLevel": "user"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!node_modules/.cache/**",
      "!*.ps1",
      "!*.bat",
      "!*.md",
      "!test-*/**",
      "!*.zip",
      "!v2/**",
      "!CleanZoom*/**"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "fileAssociations": [
      {
        "ext": "cssr",
        "name": "CleanState Sentinel Report",
        "description": "CleanState Sentinel Attestation Report",
        "icon": "assets/icon.ico",
        "role": "Viewer"
      }
    ]
  }
}
