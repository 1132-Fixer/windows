# Build-time injected config — never commit (see scripts/inject-config.js)
src/main/config.generated.js

# Secrets. The feedback proxy's GH_ISSUES_TOKEN lives in .env locally and in the
# deploy platform's env vars in production — never in this repo, and never in
# the desktop app (it would ship inside app.asar). See feedback-proxy/README.md.
.env
.env.*
!.env.example

# Signing material. A code signing certificate or key must never enter this
# repository, on any branch. Local signing reads CSC_LINK from the environment.
# See docs/security/code-signing.md.
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer

# Dependencies
node_modules/

# Build output
dist/
*.exe

# Packaged acceptance evidence (tools/packaged-acceptance.js) — uploaded as a
# CI artifact, never committed.
acceptance-evidence/

# OS / Editor
nul
Thumbs.db
.DS_Store
*.swp
*.swo

# Claude Code
.claude/
tmpclaude-*

# Temporary scripts
*.ps1
!scripts/**/*.ps1
!tools/**/*.ps1

# Logs & debug output
*.log
*-result.txt

# Test scripts
test-clean-user.js

# Packaged update acceptance (tools/build-update-test-pair.js,
# tools/packaged-update-acceptance.js): test installers and evidence.
update-acceptance/

# Packaged inactivity acceptance evidence (tools/packaged-inactivity-acceptance.js)
inactivity-evidence/
# Discovery-section evidence (scratch probe)
discovery-evidence/

# Landing-screen evidence (scratch probe)
landing-evidence/

# Packaged update acceptance (tools/build-update-test-pair.js,
# tools/packaged-update-acceptance.js): test installers and evidence.
update-acceptance/
