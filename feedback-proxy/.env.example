# Copy to .env for local dev. NEVER commit a real token.
#
# Fine-grained PAT, scoped as narrowly as possible:
#   Resource owner : PrimeUpYourLife
#   Repository     : Only select repositories -> 1132-Fixer-Windows
#   Permissions    : Issues -> Read and write   (nothing else)
#   Expiration     : set one
#
# This value lives ONLY here and in the deploy platform's env vars.
# It must never appear in the desktop app, in src/main/, or in git.
GH_ISSUES_TOKEN=github_pat_replace_me

# Repo that feedback issues are opened against.
GH_ISSUES_REPO=PrimeUpYourLife/1132-Fixer-Windows

# Railway/Heroku/etc. inject PORT automatically; only set this for local dev.
PORT=3000
